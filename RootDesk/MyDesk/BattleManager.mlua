@Component
script BattleManager extends Component

    property number MaxHp          = 100.0
    property number ScorePerSecond = 10.0   -- 초당 점수 (생존 시 적립)
    property number BossHitScore   = 5.0    -- 보스 피격 보너스

    method void OnBeginPlay()
        if self:IsServer() then
            self._T.hpMap    = {}
            self._T.nameMap  = {}
            self._T.scoreMap = {}
            self._T.players  = {}
            -- 1초마다 플레이어 탐색 + 점수 적립
            self._T.scoreTimerId = _TimerService:SetTimerRepeat(function()
                self:TickScore()
            end, 1.0)
            log("[BattleManager] 초기화 완료")
        else
            local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
            if isvalid(uiGroup) then
                uiGroup.Enable = true
                log("[BattleManager] 배틀 UI 표시")
            else
                log_warning("[BattleManager] UI 없음: /ui/랭킹전_배틀-UI")
            end
        end
    end

    method void OnEndPlay()
        if self:IsServer() then
            if self._T.scoreTimerId and self._T.scoreTimerId ~= 0 then
                _TimerService:ClearTimer(self._T.scoreTimerId)
                self._T.scoreTimerId = 0
            end
        else
            local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
            if isvalid(uiGroup) then uiGroup.Enable = false end
        end
    end

    -- ── 초당 타이머: 플레이어 자동 등록 + 점수 적립 ──────────────────
    @ExecSpace("ServerOnly")
    method void TickScore()
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local mapComp = map.MapComponent
        if not isvalid(mapComp) then return end

        local users = _UserService:GetUsersByMapComponent(mapComp)
        if users == nil or #users < 1 then return end

        for _, user in ipairs(users) do
            if isvalid(user) then
                local pc = user.PlayerComponent
                if isvalid(pc) then
                    local uid = tostring(pc.UserId)

                    -- 처음 보는 플레이어면 자동 등록
                    if self._T.hpMap[uid] == nil then
                        self._T.hpMap[uid]    = self.MaxHp
                        self._T.nameMap[uid]  = pc.Nickname
                        self._T.scoreMap[uid] = 0.0
                        table.insert(self._T.players, uid)
                        log("[BattleManager] 플레이어 등록: " .. uid .. " (" .. pc.Nickname .. ")")
                    end

                    -- HP > 0이면 점수 적립
                    if (self._T.hpMap[uid] or 0.0) > 0.0 then
                        self._T.scoreMap[uid] = (self._T.scoreMap[uid] or 0.0) + self.ScorePerSecond
                    end
                end
            end
        end

        self:BroadcastAll()
    end

    -- ── 보스 피격 보너스 (5단계 플레이어 공격에서 호출) ───────────────
    @ExecSpace("ServerOnly")
    method void AddBossHitScore(Entity player)
        if not isvalid(player) then return end
        local pc = player.PlayerComponent
        if not isvalid(pc) then return end
        local uid = tostring(pc.UserId)
        if self._T.scoreMap[uid] == nil then return end

        self._T.scoreMap[uid] = self._T.scoreMap[uid] + self.BossHitScore
        log("[BattleManager] 보스 피격 보너스 +" .. tostring(self.BossHitScore) .. " → " .. uid)
        self:BroadcastAll()
    end

    -- ── 피격 처리 ──────────────────────────────────────────────────────
    @ExecSpace("ServerOnly")
    method void TakeDamage(Entity player, number damage)
        if not isvalid(player) then return end
        local pc = player.PlayerComponent
        if not isvalid(pc) then return end
        local uid = tostring(pc.UserId)

        -- 아직 등록 안 됐으면 무시
        if self._T.hpMap[uid] == nil then return end

        local hp = math.max(0.0, self._T.hpMap[uid] - damage)
        self._T.hpMap[uid] = hp
        log("[BattleManager] " .. uid .. " 피격 -" .. tostring(damage) .. " → HP=" .. tostring(hp))

        self:BroadcastAll()

        -- TODO: 6단계에서 hp == 0 패배 처리 추가
    end

    -- ── HP + 점수 통합 브로드캐스트 ───────────────────────────────────
    @ExecSpace("ServerOnly")
    method void BroadcastAll()
        if #self._T.players < 2 then return end

        local uid1   = self._T.players[1]
        local uid2   = self._T.players[2]
        local hp1    = self._T.hpMap[uid1]    or self.MaxHp
        local hp2    = self._T.hpMap[uid2]    or self.MaxHp
        local name1  = self._T.nameMap[uid1]  or "P1"
        local name2  = self._T.nameMap[uid2]  or "P2"
        local score1 = self._T.scoreMap[uid1] or 0.0
        local score2 = self._T.scoreMap[uid2] or 0.0

        self:MulticastBattleUpdate(uid1, hp1, score1, uid2, hp2, score2, name1, name2)
    end

    -- 하위 호환 (BossProjectile에서 BroadcastHp 호출 대비)
    @ExecSpace("ServerOnly")
    method void BroadcastHp()
        self:BroadcastAll()
    end

    -- ── UI 표시/숨김 ──────────────────────────────────────────────────
    @ExecSpace("Multicast")
    method void ShowBattleUI()
        local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
        if isvalid(uiGroup) then uiGroup.Enable = true end
    end

    @ExecSpace("Multicast")
    method void HideBattleUI()
        local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
        if isvalid(uiGroup) then uiGroup.Enable = false end
    end

    -- ── 통합 Multicast ────────────────────────────────────────────────
    @ExecSpace("Multicast")
    method void MulticastBattleUpdate(string uid1, number hp1, number score1, string uid2, number hp2, number score2, string name1, string name2)
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return end

        local myId = tostring(localPlayer.PlayerComponent.UserId)
        local myHp, enemyHp, myScore, enemyScore, myName, enemyName

        if myId == uid1 then
            myHp = hp1; enemyHp = hp2; myScore = score1; enemyScore = score2
            myName = name1; enemyName = name2
        else
            myHp = hp2; enemyHp = hp1; myScore = score2; enemyScore = score1
            myName = name2; enemyName = name1
        end

        local hudEntity = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI/BattleHUD")
        if not isvalid(hudEntity) then return end
        local hud = hudEntity:GetComponent("script.BattleHUD")
        if isvalid(hud) then
            hud:UpdateHp(myHp, enemyHp, myName, enemyName)
            hud:UpdateScore(myScore, enemyScore)
        end
    end

end
