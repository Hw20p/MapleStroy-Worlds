@Component
script BattleManager extends Component

    -- ── 기본 설정 ──────────────────────────────────────────────────────
    property number MaxHp            = 100.0
    property number ScorePerSecond   = 10.0
    property number BossHitScore     = 5.0
    property number BossHpBase       = 50.0   -- 1스테이지 보스 HP
    property number BossHpPerStage   = 30.0   -- 스테이지당 HP 증가
    property number AugmentSelectTime = 30.0  -- 증강 선택 제한 시간

    -- ── 증강 정의 (인덱스 1~4, 클라이언트 AugmentSelectHUD와 동기화) ──
    -- 1: 탄속 강화   speed  +1.0
    -- 2: 탄막 증가   count  +2
    -- 3: 공격 가속   interval -0.3 (min 1.0)
    -- 4: 파워 업     speed +0.5 + count +1

    method void OnBeginPlay()
        if self:IsServer() then
            self._T.hpMap             = {}
            self._T.nameMap           = {}
            self._T.survivalScoreMap  = {}   -- 초당 생존 점수
            self._T.attackScoreMap    = {}   -- 보스 공격 점수
            self._T.players  = {}
            -- 스테이지 상태
            self._T.stage      = 1
            self._T.bossHp     = self.BossHpBase
            self._T.bossMaxHp  = self.BossHpBase
            self._T.phase      = "battle"   -- "battle" | "selecting" | "starting"
            self._T.selections = {}         -- uid -> augmentIndex
            self._T.selectTimerId = 0
            -- 보스 현재 설정 (누적)
            self._T.bossConfig = { speed=5.0, count=8, interval=2.5 }
            -- 점수 타이머
            self._T.scoreTimerId = _TimerService:SetTimerRepeat(function()
                self:TickScore()
            end, 1.0)
            log("[BattleManager] 초기화 완료 (1스테이지)")
        else
            local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
            if isvalid(uiGroup) then
                uiGroup.Enable = true
                log("[BattleManager] 배틀 UI 표시")
            else
                log_warning("[BattleManager] UI 없음: /ui/랭킹전_배틀-UI")
            end
        end
    end

    method void OnEndPlay()
        if self:IsServer() then
            if self._T.scoreTimerId and self._T.scoreTimerId ~= 0 then
                _TimerService:ClearTimer(self._T.scoreTimerId)
            end
            if self._T.selectTimerId and self._T.selectTimerId ~= 0 then
                _TimerService:ClearTimer(self._T.selectTimerId)
            end
        else
            local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
            if isvalid(uiGroup) then uiGroup.Enable = false end
        end
    end

    -- ── 초당 타이머: 플레이어 등록 + 점수 적립 ───────────────────────
    @ExecSpace("ServerOnly")
    method void TickScore()
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local mapComp = map.MapComponent
        if not isvalid(mapComp) then return end

        local users = _UserService:GetUsersByMapComponent(mapComp)
        if users == nil or #users < 1 then return end

        for _, user in ipairs(users) do
            if isvalid(user) then
                local pc = user.PlayerComponent
                if isvalid(pc) then
                    local uid = tostring(pc.UserId)
                    if self._T.hpMap[uid] == nil then
                        self._T.hpMap[uid]            = self.MaxHp
                        self._T.nameMap[uid]          = pc.Nickname
                        self._T.survivalScoreMap[uid] = 0.0
                        self._T.attackScoreMap[uid]   = 0.0
                        table.insert(self._T.players, uid)
                        log("[BattleManager] 플레이어 등록: " .. uid .. " (" .. pc.Nickname .. ")")
                    end
                    -- 배틀 중이고 HP > 0이면 생존 점수 적립
                    if self._T.phase == "battle" and (self._T.hpMap[uid] or 0.0) > 0.0 then
                        self._T.survivalScoreMap[uid] = (self._T.survivalScoreMap[uid] or 0.0) + self.ScorePerSecond
                    end
                end
            end
        end

        -- 보스 자동 HP 감소 (배틀 중 초당 1)
        if self._T.phase == "battle" then
            self._T.bossHp = math.max(0.0, (self._T.bossHp or 0.0) - 1.0)
            if self._T.bossHp <= 0.0 then
                self:OnStageClear()
                return
            end
        end

        self:BroadcastAll()
    end

    -- ── 보스 피격 처리 (5단계: 플레이어 공격에서 호출) ───────────────
    @ExecSpace("ServerOnly")
    method void TakeBossDamage(number damage, Entity attacker)
        if self._T.phase ~= "battle" then return end

        self._T.bossHp = math.max(0.0, (self._T.bossHp or 0.0) - damage)
        log("[BattleManager] 보스 피격 -" .. tostring(damage) .. " → HP=" .. tostring(self._T.bossHp))

        -- 보스 피격 점수 보너스
        if isvalid(attacker) then
            self:AddBossHitScore(attacker)
        end

        self:BroadcastAll()

        if self._T.bossHp <= 0.0 then
            self:OnStageClear()
        end
    end

    -- ── 보스 피격 점수 보너스 ─────────────────────────────────────────
    @ExecSpace("ServerOnly")
    method void AddBossHitScore(Entity player)
        if not isvalid(player) then return end
        local pc = player.PlayerComponent
        if not isvalid(pc) then return end
        local uid = tostring(pc.UserId)
        if self._T.attackScoreMap[uid] == nil then return end
        self._T.attackScoreMap[uid] = self._T.attackScoreMap[uid] + self.BossHitScore
    end

    -- ── 플레이어 피격 처리 ────────────────────────────────────────────
    @ExecSpace("ServerOnly")
    method void TakeDamage(Entity player, number damage)
        if not isvalid(player) then return end
        local pc = player.PlayerComponent
        if not isvalid(pc) then return end
        local uid = tostring(pc.UserId)
        if self._T.hpMap[uid] == nil then return end

        local hp = math.max(0.0, self._T.hpMap[uid] - damage)
        self._T.hpMap[uid] = hp
        log("[BattleManager] " .. uid .. " 피격 -" .. tostring(damage) .. " → HP=" .. tostring(hp))
        self:BroadcastAll()

        if hp <= 0.0 then
            self:OnGameEnd(uid)
        end
    end

    -- ── 게임 종료 (패배자 uid) ────────────────────────────────────────
    @ExecSpace("ServerOnly")
    method void OnGameEnd(string loserUid)
        if self._T.phase == "ended" then return end   -- 중복 방지
        self._T.phase = "ended"
        log("[BattleManager] 게임 종료 - 패배자: " .. loserUid)

        -- 타이머 정지
        if self._T.scoreTimerId and self._T.scoreTimerId ~= 0 then
            _TimerService:ClearTimer(self._T.scoreTimerId)
            self._T.scoreTimerId = 0
        end
        if self._T.selectTimerId and self._T.selectTimerId ~= 0 then
            _TimerService:ClearTimer(self._T.selectTimerId)
            self._T.selectTimerId = 0
        end

        -- 보스 탄막 정지
        local boss = self:GetBossAI()
        if isvalid(boss) then boss:PauseAttack() end

        -- 승리자 uid 결정
        local winnerUid = ""
        for _, uid in ipairs(self._T.players) do
            if uid ~= loserUid then
                winnerUid = uid
                break
            end
        end

        -- 점수 취합
        local loserSurv  = self._T.survivalScoreMap[loserUid]  or 0.0
        local loserAtk   = self._T.attackScoreMap[loserUid]    or 0.0
        local winnerSurv = self._T.survivalScoreMap[winnerUid] or 0.0
        local winnerAtk  = self._T.attackScoreMap[winnerUid]   or 0.0
        local loserName  = self._T.nameMap[loserUid]           or "패배자"
        local winnerName = self._T.nameMap[winnerUid]          or "승리자"
        local stage      = self._T.stage or 1

        -- 증강 UI 숨기기 (혹시 열려 있으면)
        self:MulticastHideAugmentUI()

        -- 결과 화면 표시 (1초 후 — 마지막 HP 브로드캐스트가 먼저 도착하도록)
        local ls = loserSurv; local la = loserAtk
        local ws = winnerSurv; local wa = winnerAtk
        local ln = loserName; local wn = winnerName
        local lid = loserUid; local wid = winnerUid
        local st = stage
        _TimerService:SetTimerOnce(function()
            self:MulticastShowResult(lid, ln, ls, la, wid, wn, ws, wa, st)
        end, 1.0)
    end

    -- ── 스테이지 클리어 ───────────────────────────────────────────────
    @ExecSpace("ServerOnly")
    method void OnStageClear()
        self._T.phase = "selecting"
        log("[BattleManager] " .. tostring(self._T.stage) .. "스테이지 클리어! 증강 선택 시작")

        -- 보스 탄막 정지
        local boss = self:GetBossAI()
        if isvalid(boss) then boss:PauseAttack() end

        -- 선택 초기화
        self._T.selections = {}

        -- 클라이언트에 증강 선택 UI 표시
        self:MulticastShowAugmentUI(self._T.stage)

        -- 15초 후 자동 처리
        self._T.selectTimerId = _TimerService:SetTimerOnce(function()
            self:OnSelectionTimeout()
        end, self.AugmentSelectTime)
    end

    -- ── 타임아웃: 미선택 플레이어에게 랜덤 배정 ─────────────────────
    @ExecSpace("ServerOnly")
    method void OnSelectionTimeout()
        log("[BattleManager] 선택 시간 초과 - 미선택자 랜덤 배정")
        for _, uid in ipairs(self._T.players) do
            if self._T.selections[uid] == nil then
                local rand = math.floor(_UtilLogic:RandomDouble() * 4) + 1
                self._T.selections[uid] = rand
                log("[BattleManager] 랜덤 배정: " .. uid .. " → " .. tostring(rand))
            end
        end
        self:ApplyAugmentsAndNextStage()
    end

    -- ── 플레이어 증강 선택 (클라이언트 → 서버 RPC) ───────────────────
    @ExecSpace("Server")
    method void RequestSelectAugment(integer augmentIndex)
        if self._T.phase ~= "selecting" then return end
        if augmentIndex < 1 or augmentIndex > 4 then return end

        -- senderUserId로 선택한 플레이어 식별
        local uid = tostring(senderUserId)
        if self._T.selections[uid] ~= nil then return end  -- 이미 선택함

        self._T.selections[uid] = augmentIndex
        log("[BattleManager] " .. uid .. " 증강 선택: " .. tostring(augmentIndex))

        -- 선택 확인 알림
        self:MulticastConfirmSelection(uid, augmentIndex)

        -- 모두 선택했는지 확인
        local allSelected = true
        for _, id in ipairs(self._T.players) do
            if self._T.selections[id] == nil then
                allSelected = false
                break
            end
        end

        if allSelected and #self._T.players >= 2 then
            -- 타임아웃 타이머 취소
            if self._T.selectTimerId ~= 0 then
                _TimerService:ClearTimer(self._T.selectTimerId)
                self._T.selectTimerId = 0
            end
            self:ApplyAugmentsAndNextStage()
        end
    end

    -- ── 증강 적용 + 다음 스테이지 시작 ───────────────────────────────
    @ExecSpace("ServerOnly")
    method void ApplyAugmentsAndNextStage()
        -- 수집된 선택들 모두 적용
        for uid, idx in pairs(self._T.selections) do
            local cfg = self._T.bossConfig
            if idx == 1 then
                cfg.speed    = cfg.speed + 1.0
                log("[BattleManager] 증강 적용: 탄속 강화")
            elseif idx == 2 then
                cfg.count    = cfg.count + 2
                log("[BattleManager] 증강 적용: 탄막 증가")
            elseif idx == 3 then
                cfg.interval = math.max(1.0, cfg.interval - 0.3)
                log("[BattleManager] 증강 적용: 공격 가속")
            elseif idx == 4 then
                cfg.speed    = cfg.speed + 0.5
                cfg.count    = cfg.count + 1
                log("[BattleManager] 증강 적용: 파워 업")
            end
        end

        -- 다음 스테이지로
        self._T.stage = self._T.stage + 1
        self:InitStage(self._T.stage)

        -- 증강 선택 UI 숨김
        self:MulticastHideAugmentUI()
    end

    -- ── 스테이지 초기화 ───────────────────────────────────────────────
    @ExecSpace("ServerOnly")
    method void InitStage(integer stage)
        -- 보스 HP 설정 (10스테이지부터 무한)
        if stage >= 10 then
            self._T.bossMaxHp = 999999.0
        else
            self._T.bossMaxHp = self.BossHpBase + (stage - 1) * self.BossHpPerStage
        end
        self._T.bossHp = self._T.bossMaxHp
        self._T.phase  = "battle"
        log("[BattleManager] " .. tostring(stage) .. "스테이지 시작. 보스 HP=" .. tostring(self._T.bossMaxHp))

        -- 보스에게 설정 적용 + 재개
        local boss = self:GetBossAI()
        if isvalid(boss) then
            local cfg = self._T.bossConfig
            boss:SetStageConfig(cfg.speed, cfg.count, cfg.interval)
        end

        self:BroadcastAll()
    end

    -- ── 보스 엔티티에서 BossAI 컴포넌트 가져오기 ─────────────────────
    @ExecSpace("ServerOnly")
    method Component GetBossAI()
        local bossEntity = _EntityService:GetEntityByPath("/maps/랭킹전_배틀/RankingBoss")
        if isvalid(bossEntity) then
            return bossEntity:GetComponent("script.BossAI")
        end
        return nil
    end

    -- ── 통합 브로드캐스트 ─────────────────────────────────────────────
    @ExecSpace("ServerOnly")
    method void BroadcastAll()
        if #self._T.players < 2 then return end

        local uid1   = self._T.players[1]
        local uid2   = self._T.players[2]
        local hp1    = self._T.hpMap[uid1]    or self.MaxHp
        local hp2    = self._T.hpMap[uid2]    or self.MaxHp
        local name1  = self._T.nameMap[uid1]  or "P1"
        local name2  = self._T.nameMap[uid2]  or "P2"
        -- 생존 점수 / 공격 점수 분리 전달
        local surv1   = self._T.survivalScoreMap[uid1] or 0.0
        local atk1    = self._T.attackScoreMap[uid1]   or 0.0
        local surv2   = self._T.survivalScoreMap[uid2] or 0.0
        local atk2    = self._T.attackScoreMap[uid2]   or 0.0
        local bossHp    = self._T.bossHp    or self.BossHpBase
        local bossMaxHp = self._T.bossMaxHp or self.BossHpBase
        local stage     = self._T.stage     or 1

        self:MulticastBattleUpdate(uid1, hp1, surv1, atk1, uid2, hp2, surv2, atk2, name1, name2, bossHp, bossMaxHp, stage)
    end

    -- 하위 호환
    @ExecSpace("ServerOnly")
    method void BroadcastHp()
        self:BroadcastAll()
    end

    -- ── UI 제어 ───────────────────────────────────────────────────────
    @ExecSpace("Multicast")
    method void ShowBattleUI()
        local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
        if isvalid(uiGroup) then uiGroup.Enable = true end
    end

    @ExecSpace("Multicast")
    method void HideBattleUI()
        local uiGroup = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
        if isvalid(uiGroup) then uiGroup.Enable = false end
    end

    @ExecSpace("Multicast")
    method void MulticastShowAugmentUI(integer stage)
        local ui = _EntityService:GetEntityByPath("/ui/랭킹전_증강선택-UI")
        if isvalid(ui) then
            ui.Enable = true
        end
        -- AugmentSelectHUD에 스테이지 정보 전달
        local hud = _EntityService:GetEntityByPath("/ui/랭킹전_증강선택-UI/AugmentSelectHUD")
        if isvalid(hud) then
            local comp = hud:GetComponent("script.AugmentSelectHUD")
            if isvalid(comp) then
                comp:ShowSelection(stage)
            end
        end
    end

    @ExecSpace("Multicast")
    method void MulticastHideAugmentUI()
        local ui = _EntityService:GetEntityByPath("/ui/랭킹전_증강선택-UI")
        if isvalid(ui) then ui.Enable = false end
    end

    @ExecSpace("Multicast")
    method void MulticastConfirmSelection(string uid, integer augmentIndex)
        -- AugmentSelectHUD에 다른 플레이어의 선택 통보
        local hud = _EntityService:GetEntityByPath("/ui/랭킹전_증강선택-UI/AugmentSelectHUD")
        if isvalid(hud) then
            local comp = hud:GetComponent("script.AugmentSelectHUD")
            if isvalid(comp) then
                comp:OnPlayerSelected(uid, augmentIndex)
            end
        end
    end

    -- ── 대기방 복귀 요청 (클라이언트 → 서버) ────────────────────────
    @ExecSpace("Server")
    method void RequestReturnToLobby()
        -- senderUserId로 요청한 플레이어를 찾아 대기방으로 이동
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local mapComp = map.MapComponent
        if not isvalid(mapComp) then return end
        local users = _UserService:GetUsersByMapComponent(mapComp)
        if users == nil then return end
        for _, user in ipairs(users) do
            if isvalid(user) then
                local pc = user.PlayerComponent
                if isvalid(pc) and tostring(pc.UserId) == tostring(senderUserId) then
                    log("[BattleManager] 대기방 복귀: " .. pc.Nickname)
                    _TeleportService:TeleportToEntityPath(user, "/maps/2_랭킹전")
                    return
                end
            end
        end
        log_warning("[BattleManager] RequestReturnToLobby - 플레이어 못 찾음: " .. tostring(senderUserId))
    end

    -- ── 결과 화면 Multicast ───────────────────────────────────────────
    @ExecSpace("Multicast")
    method void MulticastShowResult(string loserUid, string loserName, number loserSurv, number loserAtk, string winnerUid, string winnerName, number winnerSurv, number winnerAtk, integer stage)
        -- 배틀 UI 숨김
        local battleUI = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI")
        if isvalid(battleUI) then battleUI.Enable = false end

        -- 결과 UI 표시
        local resultUI = _EntityService:GetEntityByPath("/ui/랭킹전_결과-UI")
        if isvalid(resultUI) then resultUI.Enable = true end

        -- 내가 누군지 판단
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return end
        local myId = tostring(localPlayer.PlayerComponent.UserId)

        local isWin = (myId == winnerUid)
        local myName, mySurv, myAtk, enemyName, enemySurv, enemyAtk
        if isWin then
            myName = winnerName; mySurv = winnerSurv; myAtk = winnerAtk
            enemyName = loserName; enemySurv = loserSurv; enemyAtk = loserAtk
        else
            myName = loserName; mySurv = loserSurv; myAtk = loserAtk
            enemyName = winnerName; enemySurv = winnerSurv; enemyAtk = winnerAtk
        end

        -- ResultHUD에 데이터 전달
        local hudEntity = _EntityService:GetEntityByPath("/ui/랭킹전_결과-UI/ResultHUD")
        if isvalid(hudEntity) then
            local hud = hudEntity:GetComponent("script.ResultHUD")
            if isvalid(hud) then
                hud:ShowResult(isWin, myName, mySurv, myAtk, enemyName, enemySurv, enemyAtk, stage)
            end
        end
        log("[BattleManager] 결과 화면 표시 완료 - isWin=" .. tostring(isWin))
    end

    -- ── 배틀 상태 통합 Multicast ──────────────────────────────────────
    @ExecSpace("Multicast")
    method void MulticastBattleUpdate(string uid1, number hp1, number surv1, number atk1, string uid2, number hp2, number surv2, number atk2, string name1, string name2, number bossHp, number bossMaxHp, integer stage)
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) then return end

        local myId = tostring(localPlayer.PlayerComponent.UserId)
        local myHp, enemyHp, mySurv, myAtk, enemySurv, enemyAtk, myName, enemyName

        if myId == uid1 then
            myHp = hp1; enemyHp = hp2
            mySurv = surv1; myAtk = atk1
            enemySurv = surv2; enemyAtk = atk2
            myName = name1; enemyName = name2
        else
            myHp = hp2; enemyHp = hp1
            mySurv = surv2; myAtk = atk2
            enemySurv = surv1; enemyAtk = atk1
            myName = name2; enemyName = name1
        end

        local hudEntity = _EntityService:GetEntityByPath("/ui/랭킹전_배틀-UI/BattleHUD")
        if not isvalid(hudEntity) then return end
        local hud = hudEntity:GetComponent("script.BattleHUD")
        if isvalid(hud) then
            hud:UpdateHp(myHp, enemyHp, myName, enemyName)
            hud:UpdateScore(mySurv, myAtk, enemySurv, enemyAtk)
            hud:UpdateBoss(bossHp, bossMaxHp, stage)
        end
    end

end
