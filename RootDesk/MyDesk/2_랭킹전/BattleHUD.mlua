@Component
script BattleHUD extends Component

    property Entity myHPFill      = "374383ca-c2d2-4ae6-ae5f-2acd6d790f5c"
    property Entity enemyHPFill   = "d2747f77-8ac1-481b-a1b4-835654805e46"
    property Entity myNameText    = "8cd056b9-93ab-46fb-9a16-dbd7ffeacda3"
    property Entity enemyNameText = "c55a394c-7f9f-4090-87a9-2e70c5ee3086"
    property Entity myHPText      = "cc6e729c-3335-4a3e-854c-4d5a7f94e0fe"
    property Entity enemyHPText   = "c35f4ac5-7a06-499e-a4c4-7fede1d905b9"
    property Entity myScoreText    = "43a3caab-f7a0-4d10-ad17-b28a5fd09ba1"
    property Entity enemyScoreText = "07eb25a4-843f-4883-b5f1-5e3e3fd9d35f"
    property Entity bossHPFill     = "8f71af40-e885-464c-b6ec-41ccef8b7c26"
    property Entity bossHPText     = "978a4d52-ef3e-4c71-b8c8-c181b85d849f"
    property Entity stageText      = "2175f019-b2f6-4435-ad7d-a238974ae10c"
    property number MaxHp = 100.0

    @ExecSpace("ClientOnly")
    method void UpdateHp(number myHp, number enemyHp, string myName, string enemyName)
        -- HP 바 FillAmount 업데이트
        if isvalid(self.myHPFill) then
            local fill = self.myHPFill.SpriteGUIRendererComponent
            if isvalid(fill) then
                fill.FillAmount = math.max(0.0, myHp / self.MaxHp)
            end
        end
        if isvalid(self.enemyHPFill) then
            local fill = self.enemyHPFill.SpriteGUIRendererComponent
            if isvalid(fill) then
                fill.FillAmount = math.max(0.0, enemyHp / self.MaxHp)
            end
        end

        -- 이름 텍스트 업데이트
        if isvalid(self.myNameText) then
            local txt = self.myNameText.TextComponent
            if isvalid(txt) then txt.Text = myName end
        end
        if isvalid(self.enemyNameText) then
            local txt = self.enemyNameText.TextComponent
            if isvalid(txt) then txt.Text = enemyName end
        end

        -- HP 숫자 업데이트 (예: "90/100")
        local maxInt = tostring(math.floor(self.MaxHp))
        if isvalid(self.myHPText) then
            local txt = self.myHPText.TextComponent
            if isvalid(txt) then
                txt.Text = tostring(math.floor(math.max(0.0, myHp))) .. "/" .. maxInt
            end
        end
        if isvalid(self.enemyHPText) then
            local txt = self.enemyHPText.TextComponent
            if isvalid(txt) then
                txt.Text = tostring(math.floor(math.max(0.0, enemyHp))) .. "/" .. maxInt
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateScore(number myScore, number enemyScore)
        -- 점수 텍스트 업데이트
        if isvalid(self.myScoreText) then
            local txt = self.myScoreText.TextComponent
            if isvalid(txt) then
                txt.Text = "점수: " .. tostring(math.floor(myScore))
            end
        end
        if isvalid(self.enemyScoreText) then
            local txt = self.enemyScoreText.TextComponent
            if isvalid(txt) then
                txt.Text = "점수: " .. tostring(math.floor(enemyScore))
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateBoss(number bossHp, number bossMaxHp, integer stage)
        -- 보스 HP 바
        if isvalid(self.bossHPFill) then
            local fill = self.bossHPFill.SpriteGUIRendererComponent
            if isvalid(fill) and bossMaxHp > 0 then
                fill.FillAmount = math.max(0.0, bossHp / bossMaxHp)
            end
        end
        -- 보스 HP 텍스트
        if isvalid(self.bossHPText) then
            local txt = self.bossHPText.TextComponent
            if isvalid(txt) then
                if bossMaxHp >= 999999 then
                    txt.Text = "∞"
                else
                    txt.Text = tostring(math.floor(bossHp)) .. "/" .. tostring(math.floor(bossMaxHp))
                end
            end
        end
        -- 스테이지 텍스트
        if isvalid(self.stageText) then
            local txt = self.stageText.TextComponent
            if isvalid(txt) then
                txt.Text = "STAGE " .. tostring(stage)
            end
        end
    end

end
