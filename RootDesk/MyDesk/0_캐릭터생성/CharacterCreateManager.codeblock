  "ContentProto": {
    "Use": "Json",
    "Json": {
      "CoreVersion": {
        "Major": 0,
        "Minor": 2
      },
      "ScriptVersion": {
        "Major": 1,
        "Minor": 1
      },
      "Description": "캐릭터 생성 UI 전체 관리 (직업 선택 상태, 생성 처리, DB 저장)",
      "Id": "c1a2b3c4-d5e6-f7a8-b9c0-d1e2f3a4b5c6",
      "Language": 1,
      "Name": "CharacterCreateManager",
      "Type": 1,
      "Source": 0,
      "Target": null,
      "Properties": [
        {
          "Type": "string",
          "DefaultValue": "\"\"",
          "SyncDirection": 0,
          "Attributes": [],
          "Name": "selectedJob"
        }
      ],
      "Methods": [
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": null,
          "Code": "self.selectedJob = \"\"\nlog(\"[CharacterCreate] Manager initialized\")",
          "Scope": 2,
          "ExecSpace": 0,
          "Attributes": [],
          "Name": "OnBeginPlay"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "jobName"
            }
          ],
          "Code": "self.selectedJob = jobName\nlog(\"[CharacterCreate] SelectJob start: \" .. jobName)\n\n-- 직업별 아바타 배경 이미지 (새 직업 추가 시 여기에 추가)\nlocal jobImages = {\n\twarrior = \"68e039b7fcfb454ead4913ad4b39d7ad\",\n\tmage    = \"9e4c760841b84e7a819b48616ef1ef80\",\n}\n\n-- 아바타 배경 이미지 변경\nlocal avatarBg = _EntityService:GetEntityByPath(\"/ui/0_캐릭터생성-UI/LeftPanel/AvatarWrap/Bg\")\nlog(\"[CharacterCreate] avatarBg valid: \" .. tostring(isvalid(avatarBg)))\nif isvalid(avatarBg) and jobImages[jobName] ~= nil then\n\tlog(\"[CharacterCreate] Setting ImageRUID: \" .. jobImages[jobName])\n\tavatarBg.SpriteGUIRendererComponent.ImageRUID = jobImages[jobName]\n\t-- Color가 검정이면 이미지가 안 보이므로 흰색으로 설정\n\tlocal bgCol = avatarBg.SpriteGUIRendererComponent.Color\n\tbgCol.r = 1.0\n\tbgCol.g = 1.0\n\tbgCol.b = 1.0\n\tbgCol.a = 1.0\n\tavatarBg.SpriteGUIRendererComponent.Color = bgCol\nend\n\n-- 카드 하이라이트 (새 직업 추가 시 여기에 추가)\nlocal allJobs = {\"warrior\", \"mage\"}\nfor _, job in ipairs(allJobs) do\n\tlocal cardName = \"Card\" .. job:sub(1,1):upper() .. job:sub(2)\n\tlocal cardPath = \"/ui/0_캐릭터생성-UI/RightPanel/\" .. cardName\n\tlocal card = _EntityService:GetEntityByPath(cardPath)\n\tlog(\"[CharacterCreate] card \" .. cardName .. \" valid: \" .. tostring(isvalid(card)))\n\tif isvalid(card) then\n\t\tlocal col = card.SpriteGUIRendererComponent.Color\n\t\tif job == jobName then\n\t\t\tcol.r = 0.2\n\t\t\tcol.g = 0.26\n\t\t\tcol.b = 0.44\n\t\telse\n\t\t\tcol.r = 0.06\n\t\t\tcol.g = 0.08\n\t\t\tcol.b = 0.14\n\t\tend\n\t\tcol.a = 1.0\n\t\tcard.SpriteGUIRendererComponent.Color = col\n\t\tlog(\"[CharacterCreate] color set for \" .. cardName)\n\tend\nend\nlog(\"[CharacterCreate] SelectJob done\")",
          "Scope": 2,
          "ExecSpace": 0,
          "Attributes": [],
          "Name": "SelectJob"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": null,
          "Code": "log(\"[CharacterCreate] TryCreate called, selectedJob=\" .. tostring(self.selectedJob))\nlocal function showToast(msg)\n\tlocal toastGroup = _EntityService:GetEntityByPath(\"/ui/ToastGroup\")\n\tlocal toastMsg = _EntityService:GetEntityByPath(\"/ui/ToastGroup/Toast_message\")\n\tif isvalid(toastGroup) and isvalid(toastMsg) then\n\t\ttoastGroup.Enable = true\n\t\ttoastMsg.TextComponent.Text = msg\n\t\t_TimerService:SetTimer(function()\n\t\t\tif isvalid(toastGroup) then\n\t\t\t\ttoastGroup.Enable = false\n\t\t\tend\n\t\tend, 2.0)\n\tend\nend\n\n-- 직업 선택 확인\nif self.selectedJob == \"\" then\n\tshowToast(\"직업을 선택해주세요.\")\n\treturn\nend\n\n-- 닉네임 확인\nlocal nickInput = _EntityService:GetEntityByPath(\"/ui/0_캐릭터생성-UI/BottomBar/NickInput\")\nif not isvalid(nickInput) then\n\tlog(\"[CharacterCreate] NickInput entity not found\")\n\treturn\nend\n\nlocal nickname = nickInput.TextInputComponent.Text\nif nickname == nil or nickname == \"\" then\n\tshowToast(\"닉네임을 입력해주세요.\")\n\treturn\nend\n\nif #nickname > 12 then\n\tshowToast(\"닉네임은 최대 12자까지 입력 가능합니다.\")\n\treturn\nend\n\nlog(\"[CharacterCreate] Requesting create: \" .. nickname .. \" / \" .. self.selectedJob)\nlocal player = _UserService.LocalPlayer\nif not isvalid(player) then return end\n\n-- 맵 루트 엔티티의 init 컴포넌트로 서버 저장 요청\nlocal mapEntity = _EntityService:GetEntityByPath(\"/maps/0_로그인\")\nif not isvalid(mapEntity) then\n\tlog(\"[CharacterCreate] mapEntity not found\")\n\treturn\nend\nmapEntity.init:RequestCreate(tostring(player.PlayerComponent.UserId), nickname, self.selectedJob)",
          "Scope": 2,
          "ExecSpace": 0,
          "Attributes": [],
          "Name": "TryCreate"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "payload"
            }
          ],
          "Code": "log(\"[CharacterCreate] OnCreateSuccess payload=\" .. payload)\n-- payload = \"nickname|job\"\nlocal sep = payload:find(\"|\")\nlocal nickname = payload:sub(1, sep - 1)\nlocal job = payload:sub(sep + 1)\nlog(\"[CharacterCreate] Success: \" .. nickname .. \" / \" .. job)\n\n-- 캐릭터 생성 UI 닫기\nlocal createUI = _EntityService:GetEntityByPath(\"/ui/0_캐릭터생성-UI\")\nif isvalid(createUI) then\n\tcreateUI.Enable = false\nend\n\n-- 캐릭터 선택 UI 열기\nlocal selectUI = _EntityService:GetEntityByPath(\"/ui/0_캐릭터선택-UI\")\nif isvalid(selectUI) then\n\tselectUI.Enable = true\nend",
          "Scope": 2,
          "ExecSpace": 0,
          "Attributes": [],
          "Name": "OnCreateSuccess"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "reason"
            }
          ],
          "Code": "log(\"[CharacterCreate] OnCreateFail: \" .. reason)\nlocal toastGroup = _EntityService:GetEntityByPath(\"/ui/ToastGroup\")\nlocal toastMsg = _EntityService:GetEntityByPath(\"/ui/ToastGroup/Toast_message\")\nif isvalid(toastGroup) and isvalid(toastMsg) then\n\ttoastGroup.Enable = true\n\ttoastMsg.TextComponent.Text = reason\n\t_TimerService:SetTimer(function()\n\t\tif isvalid(toastGroup) then\n\t\t\ttoastGroup.Enable = false\n\t\tend\n\tend, 2.0)\nend",
          "Scope": 2,
          "ExecSpace": 0,
          "Attributes": [],
          "Name": "OnCreateFail"
        }
      ],
      "EntityEventHandlers": []
    }
  }
}