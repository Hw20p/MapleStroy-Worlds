          "Name": "NotifyChars"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "userId"
            },
            {
              "Type": "boolean",
              "DefaultValue": "false",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "success"
            },
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "payload"
            }
          ],
          "Code": "log(\"[CharacterCreate] NotifyResult called client, success=\" .. tostring(success))\nlocal uiRoot = _EntityService:GetEntityByPath(\"/ui/0_캐릭터생성-UI\")\nlog(\"[CharacterCreate] uiRoot valid=\" .. tostring(isvalid(uiRoot)))\nif not isvalid(uiRoot) then return end\n\nif success then\n\tuiRoot.CharacterCreateManager:OnCreateSuccess(payload)\nelse\n\tuiRoot.CharacterCreateManager:OnCreateFail(payload)\nend",
          "Scope": 2,
          "ExecSpace": 6,
          "Attributes": [],
          "Name": "NotifyResult"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "userId"
            },
            {
              "Type": "integer",
              "DefaultValue": "0",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "slotIndex"
            }
          ],
          "Code": "log(\"[CharacterDelete][Server] RequestDeleteChar userId=\" .. userId .. \" slot=\" .. slotIndex)\n\nlocal storage = _DataStorageService:GetUserDataStorage(\"characters\")\nlocal errCode, raw = storage:GetAndWait(userId)\n\nlocal function parseChars(r)\n\tif type(r) ~= \"string\" then return {} end\n\tif r:sub(1,1) ~= \"[\" then return {} end\n\tlocal result = {}\n\tfor nickname, job in r:gmatch('\"nickname\":\"([^\"]*)\",\"job\":\"([^\"]*)\"') do\n\t\ttable.insert(result, { nickname = nickname, job = job })\n\tend\n\treturn result\nend\n\nlocal function serializeChars(chars)\n\tlocal parts = {}\n\tfor _, c in ipairs(chars) do\n\t\ttable.insert(parts, '{\"nickname\":\"' .. c.nickname .. '\",\"job\":\"' .. c.job .. '\"}')\n\tend\n\treturn \"[\" .. table.concat(parts, \",\") .. \"]\"\nend\n\nif errCode ~= 0 then\n\tlog(\"[CharacterDelete][Server] GetAndWait error: \" .. tostring(errCode))\n\tself:NotifyDelete(userId, false, slotIndex)\n\treturn\nend\n\nlocal chars = parseChars(raw)\nlocal luaIndex = slotIndex + 1  -- 0-based → 1-based\n\nif luaIndex < 1 or luaIndex > #chars then\n\tlog(\"[CharacterDelete][Server] invalid slot: \" .. slotIndex)\n\tself:NotifyDelete(userId, false, slotIndex)\n\treturn\nend\n\nlocal deleted = chars[luaIndex].nickname\ntable.remove(chars, luaIndex)\n\nlocal newJson = serializeChars(chars)\nlocal setErr = storage:SetAndWait(userId, newJson)\nif setErr ~= 0 then\n\tlog(\"[CharacterDelete][Server] SetAndWait error: \" .. tostring(setErr))\n\tself:NotifyDelete(userId, false, slotIndex)\n\treturn\nend\n\n-- 글로벌 닉네임 레지스트리에서 삭제\nlocal nicknameStorage = _DataStorageService:GetUserDataStorage(\"nicknames\")\nnicknameStorage:DeleteAndWait(deleted)\n\n-- _all 목록에서 제거\nlocal e, raw = nicknameStorage:GetAndWait(\"_all\")\nif e == 0 and type(raw) == \"string\" and raw:sub(1,1) == \"[\" then\n\tlocal list = {}\n\tfor n in raw:gmatch('\"([^\"]+)\"') do\n\t\tif n ~= deleted then table.insert(list, n) end\n\tend\n\tlocal parts = {}\n\tfor _, n in ipairs(list) do table.insert(parts, '\"' .. n .. '\"') end\n\tnicknameStorage:SetAndWait(\"_all\", \"[\" .. table.concat(parts, \",\") .. \"]\")\nend\n\nlog(\"[CharacterDelete][Server] Deleted nickname=\" .. deleted)\nself:NotifyDelete(userId, true, slotIndex)",
