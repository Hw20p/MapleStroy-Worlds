              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "userId"
            }
          ],
          "Code": "local storage = _DataStorageService:GetUserDataStorage(\"characters\")\nlocal errCode, raw = storage:GetAndWait(userId)\n\nlocal charsJson = \"[]\"\nif errCode == 0 and raw ~= nil then\n\tif type(raw) == \"string\" and raw:sub(1,1) == \"[\" then\n\t\tcharsJson = raw\n\tend\nelseif errCode ~= 0 and errCode ~= 1000002 then\n\tlog(\"[CharacterSelect][Server] GetAndWait error: \" .. tostring(errCode))\nend\n\nlog(\"[DB] userId=\" .. userId .. \" chars=\" .. charsJson)\n\n-- 글로벌 닉네임 목록 로그\nlocal nicknameStorage = _DataStorageService:GetUserDataStorage(\"nicknames\")\nlocal ne, nraw = nicknameStorage:GetAndWait(\"_all\")\nlog(\"[DB][nicknames] all=\" .. tostring(nraw))\n\nself:NotifyChars(userId, charsJson)",
          "Scope": 1,
          "ExecSpace": 5,
          "Attributes": [],
          "Name": "RequestLoadChars"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
