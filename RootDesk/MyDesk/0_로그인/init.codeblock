          ],
          "Code": "log(\"[CharacterDelete] NotifyDelete client success=\" .. tostring(success))\nlocal selectUI = _EntityService:GetEntityByPath(\"/ui/0_캐릭터선택-UI\")\nif not isvalid(selectUI) then return end\nif not selectUI.Enable then return end\n\nif success then\n\t-- 삭제 성공: 목록 새로고침\n\tlocal player = _UserService.LocalPlayer\n\tif isvalid(player) then\n\t\tlocal mapEntity = _EntityService:GetEntityByPath(\"/maps/0_로그인\")\n\t\tif isvalid(mapEntity) then\n\t\t\tmapEntity.init:RequestLoadChars(tostring(player.PlayerComponent.UserId))\n\t\tend\n\tend\nelse\n\t-- 삭제 실패 토스트\n\tlocal toastGroup = _EntityService:GetEntityByPath(\"/ui/ToastGroup\")\n\tlocal toastMsg = _EntityService:GetEntityByPath(\"/ui/ToastGroup/Toast_message\")\n\tif isvalid(toastGroup) and isvalid(toastMsg) then\n\t\ttoastGroup.Enable = true\n\t\ttoastMsg.TextComponent.Text = \"캐릭터 삭제에 실패했습니다.\"\n\t\t_TimerService:SetTimer(2, function()\n\t\t\tif isvalid(toastGroup) then toastGroup.Enable = false end\n\t\tend)\n\tend\nend",
          "Scope": 2,
          "ExecSpace": 6,
          "Attributes": [],
          "Name": "NotifyDelete"
        }
      ]
    }
