              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "userId"
            },
            {
              "Type": "string",
              "DefaultValue": "\"[]\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "charsJson"
            }
          ],
          "Code": "log(\"[CharacterSelect] NotifyChars client, json=\" .. tostring(charsJson))\nlocal selectUI = _EntityService:GetEntityByPath(\"/ui/0_캐릭터선택-UI\")\nif not isvalid(selectUI) then return end\nif not selectUI.Enable then return end\n\nselectUI.CharacterSelectManager:PopulateSlots(charsJson)",
          "Scope": 2,
          "ExecSpace": 6,
          "Attributes": [],
          "Name": "NotifyChars"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "userId"
            },
            {
              "Type": "boolean",
              "DefaultValue": "false",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "success"
            },
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "payload"
            }
          ],
          "Code": "log(\"[CharacterCreate] NotifyResult called client, success=\" .. tostring(success))\nlocal uiRoot = _EntityService:GetEntityByPath(\"/ui/0_캐릭터생성-UI\")\nlog(\"[CharacterCreate] uiRoot valid=\" .. tostring(isvalid(uiRoot)))\nif not isvalid(uiRoot) then return end\n\nif success then\n\tuiRoot.CharacterCreateManager:OnCreateSuccess(payload)\nelse\n\tuiRoot.CharacterCreateManager:OnCreateFail(payload)\nend",
          "Scope": 2,
          "ExecSpace": 6,
          "Attributes": [],
          "Name": "NotifyResult"
        }
      ]
    }
  }
