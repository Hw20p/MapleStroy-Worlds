          "Arguments": null,
          "Code": "local player = _UserService.LocalPlayer\nif not isvalid(player) then\n\treturn\nend\n\nlocal playerComp = player.PlayerComponent\nif not isvalid(playerComp) then\n\treturn\nend\n\nlocal nickname = playerComp.Nickname\nlocal profileCode = playerComp.ProfileCode\n\nlog(\"[LoginUI] Nickname: \" .. tostring(nickname) .. \", UserId: \" .. tostring(profileCode))\n\nlocal nameText = _EntityService:GetEntityByPath(\"/ui/0_로그인-UI/사용자정보/계정이름_text\")\nif isvalid(nameText) then\n\tnameText.TextComponent.Text = nickname\nend\n\nlocal codeText = _EntityService:GetEntityByPath(\"/ui/0_로그인-UI/사용자정보/계정코드_text\")\nif isvalid(codeText) then\n\tcodeText.TextComponent.Text = \"#\" .. profileCode\nend",
          "Scope": 2,
          "ExecSpace": 0,
          "Attributes": [],
          "Name": "OnBeginPlay"
        }
      ],
      "EntityEventHandlers": [],
      "Methods": [
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": null,
          "Code": "local player = _UserService.LocalPlayer\nif not isvalid(player) then\n\treturn\nend\n\nlocal playerComp = player.PlayerComponent\nif not isvalid(playerComp) then\n\treturn\nend\n\nlocal nickname = playerComp.Nickname\nlocal profileCode = playerComp.ProfileCode\n\nlog(\"[LoginUI] Nickname: \" .. tostring(nickname) .. \", UserId: \" .. tostring(profileCode))\n\nlocal nameText = _EntityService:GetEntityByPath(\"/ui/0_로그인-UI/사용자정보/계정이름_text\")\nif isvalid(nameText) then\n\tnameText.TextComponent.Text = nickname\nend\n\nlocal codeText = _EntityService:GetEntityByPath(\"/ui/0_로그인-UI/사용자정보/계정코드_text\")\nif isvalid(codeText) then\n\tcodeText.TextComponent.Text = \"#\" .. profileCode\nend",
          "Scope": 2,
          "ExecSpace": 0,
          "Attributes": [],
          "Name": "OnBeginPlay"
        },
        {
          "Return": {
            "Type": "void",
            "DefaultValue": null,
            "SyncDirection": 0,
            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "userId"
            },
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "nickname"
            },
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "job"
            }
          ],
          "Code": "log(\"[CharacterCreate][Server] RequestCreate userId=\" .. userId .. \" nickname=\" .. nickname .. \" job=\" .. job)\n\nlocal storage = _DataStorageService:GetUserDataStorage(\"characters\")\nlocal nicknameStorage = _DataStorageService:GetUserDataStorage(\"nicknames\")\n\n-- 헬퍼 함수들\nlocal function parseChars(raw)\n\tif type(raw) ~= \"string\" or raw:sub(1,1) ~= \"[\" then return {} end\n\tlocal result = {}\n\tfor n, j in raw:gmatch('\"nickname\":\"([^\"]*)\",\"job\":\"([^\"]*)\"') do\n\t\ttable.insert(result, { nickname = n, job = j })\n\tend\n\treturn result\nend\n\nlocal function serializeChars(chars)\n\tlocal parts = {}\n\tfor _, c in ipairs(chars) do\n\t\ttable.insert(parts, '{\"nickname\":\"' .. c.nickname .. '\",\"job\":\"' .. c.job .. '\"}')\n\tend\n\treturn \"[\" .. table.concat(parts, \",\") .. \"]\"\nend\n\nlocal function getNicknameList()\n\tlocal e, raw = nicknameStorage:GetAndWait(\"_all\")\n\tif e == 0 and type(raw) == \"string\" and raw:sub(1,1) == \"[\" then\n\t\tlocal list = {}\n\t\tfor n in raw:gmatch('\"([^\"]+)\"') do table.insert(list, n) end\n\t\treturn list\n\tend\n\treturn {}\nend\n\nlocal function saveNicknameList(list)\n\tlocal parts = {}\n\tfor _, n in ipairs(list) do table.insert(parts, '\"' .. n .. '\"') end\n\tnicknameStorage:SetAndWait(\"_all\", \"[\" .. table.concat(parts, \",\") .. \"]\")\nend\n\n-- 캐릭터 목록 불러오기\nlocal errCode, raw = storage:GetAndWait(userId)\nlocal chars = {}\nif errCode == 0 and raw ~= nil then\n\tchars = parseChars(raw)\nelseif errCode ~= 0 and errCode ~= 1000002 then\n\tself:NotifyResult(userId, false, \"서버 오류가 발생했습니다. (\" .. tostring(errCode) .. \")\")\n\treturn\nend\n\nif #chars >= 3 then\n\tself:NotifyResult(userId, false, \"캐릭터는 최대 3개까지 생성 가능합니다.\")\n\treturn\nend\n\n-- 글로벌 닉네임 중복 확인\nlocal nickErrCode, existingOwner = nicknameStorage:GetAndWait(nickname)\nif nickErrCode == 0 and existingOwner ~= nil then\n\tself:NotifyResult(userId, false, \"이미 사용 중인 닉네임입니다.\")\n\treturn\nelseif nickErrCode ~= 0 and nickErrCode ~= 1000002 then\n\tself:NotifyResult(userId, false, \"서버 오류가 발생했습니다. (\" .. tostring(nickErrCode) .. \")\")\n\treturn\nend\n\n-- 닉네임 등록\nlocal nickSetErr = nicknameStorage:SetAndWait(nickname, userId)\nif nickSetErr ~= 0 then\n\tself:NotifyResult(userId, false, \"저장 중 오류가 발생했습니다. (\" .. tostring(nickSetErr) .. \")\")\n\treturn\nend\n\n-- _all 목록 업데이트\nlocal allList = getNicknameList()\ntable.insert(allList, nickname)\nsaveNicknameList(allList)\n\n-- 캐릭터 저장\ntable.insert(chars, { nickname = nickname, job = job })\nlocal newJson = serializeChars(chars)\nlocal setErr = storage:SetAndWait(userId, newJson)\nif setErr ~= 0 then\n\tnicknameStorage:DeleteAndWait(nickname)\n\tself:NotifyResult(userId, false, \"저장 중 오류가 발생했습니다. (\" .. tostring(setErr) .. \")\")\n\treturn\nend\n\nlog(\"[CharacterCreate][Server] Saved OK. total chars=\" .. tostring(#chars))\nself:NotifyResult(userId, true, nickname .. \"|\" .. job)",
          "Scope": 1,
