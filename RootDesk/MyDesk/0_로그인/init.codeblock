            "Attributes": [],
            "Name": null
          },
          "Arguments": [
            {
              "Type": "string",
              "DefaultValue": "\"\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "userId"
            },
            {
              "Type": "string",
              "DefaultValue": "\"[]\"",
              "SyncDirection": 0,
              "Attributes": [],
              "Name": "charsJson"
            }
          ],
          "Code": "local selectUI = _EntityService:GetEntityByPath(\"/ui/0_캐릭터선택-UI\")\nif not isvalid(selectUI) then return end\nif not selectUI.Enable then return end\n\nselectUI.CharacterSelectManager:PopulateSlots(charsJson)",
          "Scope": 2,
